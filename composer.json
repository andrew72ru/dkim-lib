{
    "name": "andrew72ru/dkim-lib",
    "description": "A package to verify the DKIM signature of an email message",
    "type": "library",
    "license": "MIT",
    "minimum-stability": "stable",
    "authors": [
        {
            "name": "Andrew Zhdanovskikh",
            "email": "andrew72ru@gmail.com"
        }
    ],
    "autoload": {
        "psr-4": {
